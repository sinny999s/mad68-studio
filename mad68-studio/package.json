{
  "name": "mad68-studio",
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "app": "vite build && electron .",
    "app:dev": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/w3c-web-hid": "^1.0.7",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.21.0",
    "globals": "^17.7.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "runed": "^0.37.1",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "productName": "MAD68 Studio",
  "description": "Desktop configurator for the MadLions MAD68 HE (libhmk)",
  "main": "electron/main.cjs",
  "license": "GPL-3.0-or-later",
  "author": "devyn",
  "build": {
    "appId": "dev.devyn.mad68studio",
    "productName": "MAD68 Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "MAD68-Studio-${version}-portable.exe",
      "icon": "static/web-app-manifest-512x512.png"
    },
    "portable": {
      "artifactName": "MAD68-Studio-${version}-portable.exe"
    }
  }
}
